{
  "name": "draft-arena-game",
  "private": true,
  "version": "0.1.0",
  "description": "Multiplayer .io arena: weapons fire themselves, you draft an upgrade every level, other players are the real threat.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host",
    "server": "node engine/server/main.ts",
    "build": "vite build --logLevel warn",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "smoke": "node ../../../loop/smoke/smoke.ts",
    "verify": "npm run check && npm run smoke",
    "soak": "node engine/tools/soak.ts"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/fredoka": "5.3.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
