diff --git a/projects/chokepoint/game/src/core/chain.ts b/projects/chokepoint/game/src/core/chain.ts
new file mode 100644
index 0000000..2acee23
--- /dev/null
+++ b/projects/chokepoint/game/src/core/chain.ts
@@ -0,0 +1,48 @@
+import { pickTarget, type TargetCandidate } from './targeting';
+
+/**
+ * A Chain attack's strikes: the enemy furthest along in `range` of (x, y), then up to
+ * `count - 1` leaps to the nearest not-yet-struck enemies. The first strike counts as one of
+ * the `count` strikes. [] when nothing is in range.
+ */
+export function pickChain(x: number, y: number, range: number, reach: number, enemies: readonly TargetCandidate[], count: number): number[] {
+  if (count <= 0) return [];
+  const first = pickTarget(x, y, range, enemies);
+  if (first === -1) return [];
+  return [first, ...pickLeaps(first, reach, enemies, [first], count - 1)];
+}
+
+/**
+ * Up to `count` leap targets starting at the enemy at index `from`: each leap is the nearest
+ * active enemy that is not in `struck`, within `reach` (board units) of the previous strike (a
+ * gap of exactly `reach` counts). Ties go to the enemy later in the list. Stops early when
+ * there is nothing to leap to. `from` and every index in `struck` are never returned.
+ */
+export function pickLeaps(from: number, reach: number, enemies: readonly TargetCandidate[], struck: readonly number[], count: number): number[] {
+  const out: number[] = [];
+  const struckSet = new Set<number>(struck);
+  struckSet.add(from);
+  const r2 = reach * reach;
+  let cur = enemies[from]!;
+  for (let n = 0; n < count; n++) {
+    let best = -1;
+    let bestD2 = Infinity;
+    for (let i = 0; i < enemies.length; i++) {
+      const e = enemies[i]!;
+      if (!e.active || struckSet.has(i)) continue;
+      const dx = e.x - cur.x;
+      const dy = e.y - cur.y;
+      const d2 = dx * dx + dy * dy;
+      if (d2 > r2) continue;
+      if (d2 <= bestD2) {
+        best = i;
+        bestD2 = d2;
+      }
+    }
+    if (best === -1) break;
+    out.push(best);
+    struckSet.add(best);
+    cur = enemies[best]!;
+  }
+  return out;
+}
