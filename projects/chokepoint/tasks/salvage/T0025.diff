+import { describe, expect, it } from 'vitest';
+import { pickChain, pickLeaps } from '../../src/core/chain';
+import type { TargetCandidate } from '../../src/core/targeting';
+
+const enemies: TargetCandidate[] = [
+  { x: 10, y: 0, distance: 1, active: true },
+  { x: 25, y: 0, distance: 2, active: true },
+  { x: 40, y: 0, distance: 3, active: true },
+  { x: 100, y: 0, distance: 9, active: true },
+];
+
+describe('pickChain', () => {
+  it('strikes the furthest-along in range, then leaps nearest-first, every strike a different enemy', () => {
+    expect(pickChain(0, 0, 45, 20, enemies, 3)).toEqual([2, 1, 0]);
+  });
+
+  it('stops early when nothing is in leap reach, instead of wasting a leap', () => {
+    expect(pickChain(0, 0, 45, 20, enemies, 5)).toEqual([2, 1, 0]);
+  });
+
+  it('does not attack when nothing is in range', () => {
+    expect(pickChain(0, 0, 5, 20, enemies, 3)).toEqual([]);
+  });
+
+  it('skips dead enemies on the way', () => {
+    const dead = enemies.map((e, i) => (i === 1 ? { ...e, active: false } : e));
+    expect(pickChain(0, 0, 45, 20, dead, 3)).toEqual([2]);
+  });
+});
+
+describe('pickLeaps', () => {
+  it('each leap is the nearest unstruck enemy within the reach of the previous strike', () => {
+    expect(pickLeaps(0, 20, enemies, [], 3)).toEqual([1, 2]);
+  });
+
+  it('skips the struck, and never leaps to air', () => {
+    expect(pickLeaps(1, 20, enemies, [2, 1], 2)).toEqual([0]);
+    expect(pickLeaps(2, 20, enemies, [2, 1], 2)).toEqual([]);
+  });
+
+  it('includes a gap exactly at the reach, and not one beyond it', () => {
+    const one = { x: 0, y: 0, distance: 1, active: true };
+    expect(pickLeaps(0, 20, [one, { x: 20, y: 0, distance: 2, active: true }], [0], 1)).toEqual([1]);
+    expect(pickLeaps(0, 20, [one, { x: 21, y: 0, distance: 2, active: true }], [0], 1)).toEqual([]);
+  });
+});
