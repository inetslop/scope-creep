diff --git a/projects/chokepoint/game/src/core/chain.ts b/projects/chokepoint/game/src/core/chain.ts
new file mode 100644
index 0000000..7de3252
--- /dev/null
+++ b/projects/chokepoint/game/src/core/chain.ts
@@ -0,0 +1,51 @@
+import { pickTarget, type TargetCandidate } from './targeting';
+
+/**
+ * The zap: the index of the first strike, then up to `count - 1` further strikes. The first is
+ * the active enemy furthest along within `range` (board units); each further strike is the
+ * nearest active enemy not in `struck` and within `reach` of the previous strike. Stops early
+ * when nothing is in reach — a leap never goes to air. Every index it returns is different.
+ */
+export function pickChain(x: number, y: number, range: number, reach: number, enemies: readonly TargetCandidate[], count: number): number[] {
+  const first = pickTarget(x, y, range, enemies);
+  if (first < 0) return [];
+  return [first, ...pickLeaps(first, reach, enemies, [first], count - 1)];
+}
+
+/**
+ * Up to `count` further strikes continuing from enemy `from`: each is the nearest active enemy
+ * not in `struck` (and not `from` itself) within `reach` (board units) of the previous strike.
+ * Ties go to the enemy later in the list; a gap exactly at the reach is included. Stops early
+ * when nothing is in reach.
+ */
+export function pickLeaps(from: number, reach: number, enemies: readonly TargetCandidate[], struck: readonly number[], count: number): number[] {
+  const out: number[] = [];
+  const skipped = new Set<number>(struck);
+  skipped.add(from);
+  let px = enemies[from]!.x;
+  let py = enemies[from]!.y;
+  const r2 = reach * reach;
+  for (let n = 0; n < count; n++) {
+    let best = -1;
+    let bestD2 = Infinity;
+    for (let i = 0; i < enemies.length; i++) {
+      if (skipped.has(i)) continue;
+      const e = enemies[i]!;
+      if (!e.active) continue;
+      const dx = e.x - px;
+      const dy = e.y - py;
+      const d2 = dx * dx + dy * dy;
+      if (d2 > r2) continue;
+      if (d2 <= bestD2) {
+        best = i;
+        bestD2 = d2;
+      }
+    }
+    if (best < 0) break;
+    skipped.add(best);
+    out.push(best);
+    px = enemies[best]!.x;
+    py = enemies[best]!.y;
+  }
+  return out;
+}
