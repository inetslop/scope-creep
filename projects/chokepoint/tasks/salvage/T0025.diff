+import { describe, expect, it } from 'vitest';
+import { pickChain, pickLeaps } from '../../src/core/chain';
+import type { TargetCandidate } from '../../src/core/targeting';
+
+// Four enemies in a line along the x axis; distance is how far along the path (bigger: nearer the exit).
+const e: TargetCandidate[] = [
+  { x: 10, y: 0, distance: 1, active: true },
+  { x: 25, y: 0, distance: 2, active: true },
+  { x: 40, y: 0, distance: 3, active: true },
+  { x: 100, y: 0, distance: 9, active: true },
+];
+
+describe('pickChain', () => {
+  it('strikes the enemy furthest along in range, then leaps to the nearest unstruck ones', () => {
+    expect(pickChain(0, 0, 45, 20, e, 3)).toEqual([2, 1, 0]);
+  });
+
+  it('stops as soon as there is nothing left to leap to', () => {
+    expect(pickChain(0, 0, 45, 20, e, 5)).toEqual([2, 1, 0]);
+  });
+
+  it('does nothing when nothing is in range', () => {
+    expect(pickChain(0, 0, 5, 20, e, 3)).toEqual([]);
+  });
+
+  it('never leaps to an inactive enemy', () => {
+    const g: TargetCandidate[] = [{ ...e[0]! }, { ...e[1]!, active: false }, { ...e[2]! }, { ...e[3]! }];
+    expect(pickChain(0, 0, 45, 20, g, 3)).toEqual([2]);
+  });
+});
+
+describe('pickLeaps', () => {
+  it('leaps from the previous strike to the nearest unstruck enemy within reach', () => {
+    expect(pickLeaps(1, 20, e, [2, 1], 2)).toEqual([0]);
+    expect(pickLeaps(0, 20, e, [], 3)).toEqual([1, 2]);
+  });
+
+  it('returns nothing when every unstruck enemy is out of reach', () => {
+    expect(pickLeaps(2, 20, e, [2, 1], 2)).toEqual([]);
+  });
+
+  it('a gap of exactly the reach counts, one more does not', () => {
+    expect(pickLeaps(0, 15, e, [], 1)).toEqual([1]);
+    expect(pickLeaps(0, 14, e, [], 1)).toEqual([]);
+  });
+
+  it('ties go to the enemy later in the list', () => {
+    const line: TargetCandidate[] = [
+      { x: 0, y: 0, distance: 1, active: true },
+      { x: -20, y: 0, distance: 2, active: true },
+      { x: 20, y: 0, distance: 3, active: true },
+    ];
+    expect(pickLeaps(0, 45, line, [], 2)).toEqual([2, 1]);
+  });
+});
