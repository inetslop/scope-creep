+import { CELL } from '../../config';
+import { pickChain } from '../../core/chain';
+import type { Attack } from './attack';
+
+/** The Chain zap: strikes the enemy furthest along, then leaps between the unstruck ones. */
+export const chain: Attack = ({ tower, enemies, range, payload, hit, struck, fx, sfx }) => {
+  const spec = tower.spec;
+  const strikes = pickChain(tower.x, tower.y, range, spec.leapReach * CELL, enemies, spec.chainLeaps);
+  if (strikes.length === 0) return false;
+  struck.push(...strikes);
+  const first = enemies[strikes[0]!]!;
+  tower.aimAt(first.x, first.y);
+  tower.kick();
+  let from = tower.muzzle(0);
+  for (const i of strikes) {
+    const target = enemies[i]!;
+    fx.zap(from.x, from.y, target.x, target.y);
+    from = { x: target.x, y: target.y };
+    hit(target, payload);
+    sfx?.zap();
+  }
+  return true;
+};
