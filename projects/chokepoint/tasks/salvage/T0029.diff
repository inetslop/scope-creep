diff --git a/projects/chokepoint/game/src/systems/BeamSystem.ts b/projects/chokepoint/game/src/systems/BeamSystem.ts
new file mode 100644
index 0000000..151eccf
--- /dev/null
+++ b/projects/chokepoint/game/src/systems/BeamSystem.ts
@@ -0,0 +1,103 @@
+import Phaser from 'phaser';
+import { CELL, DEPTH } from '../config';
+import { PALETTE } from '../content/palette';
+import { beamTarget, secondBeamTarget, type BeamHeld } from '../core/beam';
+import { pickTarget } from '../core/targeting';
+import type { Sfx } from '../audio/Sfx';
+import type { Enemy } from '../entities/Enemy';
+import type { Tower } from '../entities/Tower';
+import type { EnemySystem } from './EnemySystem';
+import type { FxSystem } from './FxSystem';
+import type { TowerSystem } from './TowerSystem';
+
+/** What a tower's beams hold between frames (the pool recycles slots, so index and serial). */
+interface BeamState {
+  /** The main beam's held target (beam-first towers only); null while idling. */
+  main: BeamHeld | null;
+  /** The primary target it is locking on (the main beam's, else the second's), for the tick. */
+  primaryIndex: number;
+  primarySerial: number;
+}
+
+/**
+ * The beams: sustained lines that deal damage per second for as long as their target is in range
+ * - no shots, no cooldown (TowerSystem skips kind 'beam'). RunFlow runs it in the wave phase after
+ * the towers; each frame it redraws every line, strikes its targets and flashes the impact, and
+ * plays one soft lock-on tick per new target.
+ */
+export class BeamSystem {
+  private readonly towers: TowerSystem;
+  private readonly enemies: EnemySystem;
+  private readonly fx: FxSystem;
+  private readonly sfx: Sfx | undefined;
+  private readonly lines: Phaser.GameObjects.Graphics;
+  /** Per-run hold state, keyed by tower (towers belong to one run's scene). */
+  private readonly state = new Map<Tower, BeamState>();
+
+  constructor(scene: Phaser.Scene, towers: TowerSystem, enemies: EnemySystem, fx: FxSystem, sfx: Sfx | undefined) {
+    this.towers = towers;
+    this.enemies = enemies;
+    this.fx = fx;
+    this.sfx = sfx;
+    this.lines = scene.add.graphics().setDepth(DEPTH.fx);
+  }
+
+  /** Drops every line; the wave is over, so nothing persists into the draft or the build. */
+  clear(): void {
+    this.lines.clear();
+  }
+
+  update(dt: number): void {
+    const enemies = this.enemies.all;
+    this.lines.clear(); // the last wave frame has no targets, so nothing persists into build/draft
+    for (const t of this.towers.towers) {
+      const spec = t.spec;
+      if (spec.kind !== 'beam' && spec.addedBeamDps <= 0) continue;
+      const st = this.stateOf(t);
+      const range = spec.range * CELL;
+      let main = -1;
+      if (spec.kind === 'beam') {
+        main = beamTarget(t.x, t.y, range, st.main, enemies);
+        st.main = main >= 0 ? { index: main, serial: enemies[main]!.serial } : null;
+        if (main >= 0) {
+          t.aimAt(enemies[main]!.x, enemies[main]!.y);
+          this.beam(t, enemies[main]!, spec.beamDps * dt, 2);
+        }
+      }
+      let primary = main;
+      if (spec.addedBeamDps > 0) {
+        // The second beam holds the enemy nearest the main target: the first beam's when the
+        // tower is beam-first, otherwise the attack's own. It idles while that is absent.
+        const anchor = spec.kind === 'beam' ? main : pickTarget(t.x, t.y, range, enemies);
+        const second = anchor >= 0 ? secondBeamTarget(anchor, t.x, t.y, range, enemies) : -1;
+        if (spec.kind !== 'beam') primary = second;
+        if (second >= 0) this.beam(t, enemies[second]!, spec.addedBeamDps * dt, 1);
+      }
+      const serial = primary >= 0 ? enemies[primary]!.serial : 0;
+      if (primary !== st.primaryIndex || serial !== st.primarySerial) {
+        // A soft lock-on tick per new target; silent while beaming and when the beam breaks.
+        if (primary >= 0) this.sfx?.lock();
+        st.primaryIndex = primary;
+        st.primarySerial = serial;
+      }
+    }
+  }
+
+  /** One teal line from the rod's tip to the target: full width (2) on the main, half (1) on the second. */
+  private beam(t: Tower, e: Enemy, damage: number, width: number): void {
+    const m = t.muzzle(0);
+    this.lines.lineStyle(width, PALETTE.teal, 1);
+    this.lines.lineBetween(m.x, m.y, e.x, e.y);
+    this.enemies.strike(e, { damage, splash: 0, slow: undefined, pierce: 0, mark: undefined, color: PALETTE.teal, source: t, noFlash: true });
+    this.fx.beamImpact(e.x, e.y);
+  }
+
+  private stateOf(t: Tower): BeamState {
+    let st = this.state.get(t);
+    if (!st) {
+      st = { main: null, primaryIndex: -1, primarySerial: 0 };
+      this.state.set(t, st);
+    }
+    return st;
+  }
+}
