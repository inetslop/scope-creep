diff --git a/projects/chokepoint/game/tests/core/beam.test.ts b/projects/chokepoint/game/tests/core/beam.test.ts
new file mode 100644
index 0000000..165d7c0
--- /dev/null
+++ b/projects/chokepoint/game/tests/core/beam.test.ts
@@ -0,0 +1,115 @@
+import { describe, expect, it } from 'vitest';
+import { AUGMENTS, getAugment } from '../../src/content/augments';
+import { beam } from '../../src/content/augments/beam';
+import type { AugmentCopy, Tier } from '../../src/content/types';
+import { describeSpec, rollOffer, towerSpec } from '../../src/core/augments';
+import { beamTarget, secondBeamTarget, type BeamCandidate } from '../../src/core/beam';
+import { Rng } from '../../src/core/rng';
+import { tierAdded, tierAddedLine, tierFirst, tierTowerLine } from '../../src/core/tiers';
+
+const copy = (id: string, tier: Tier = 'common'): AugmentCopy => ({ id, tier });
+const spec = (...ids: string[]) => towerSpec(ids.map((id) => copy(id)));
+const e = (x: number, y: number, distance: number, serial = 1, active = true): BeamCandidate => ({ x, y, distance, active, serial });
+
+describe('the beam (Beam)', () => {
+  it('deals 6, 8 and 10 damage per second by tier', () => {
+    expect(Math.round(tierFirst(beam, 'common').beam!)).toBe(6);
+    expect(Math.round(tierFirst(beam, 'rare').beam!)).toBe(8);
+    expect(Math.round(tierFirst(beam, 'epic').beam!)).toBe(10);
+  });
+
+  it('the second beam deals half the rate: 3, 4 and 5 per second by tier', () => {
+    expect(tierAdded(beam, 'common').beam).toBe(3);
+    expect(tierAdded(beam, 'rare').beam).toBe(4);
+    expect(tierAdded(beam, 'epic').beam).toBe(5);
+  });
+
+  it('a lone Beam tower is a sustained attack: no damage, 6 per second, the normal range', () => {
+    expect(spec('beam')).toMatchObject({ attacks: true, kind: 'beam', damage: 0, beamDps: 6, range: 2.6, addedBeamDps: 0 });
+  });
+
+  it('Reach added lengthens the beam to Reach range', () => {
+    expect(spec('beam', 'reach').range).toBeCloseTo(2.6 * 1.35);
+  });
+
+  it('Beam added is a sustained second target at half rate, on any attack', () => {
+    expect(spec('bolt', 'beam')).toMatchObject({ kind: 'shot', addedBeamDps: 3, addedBeamCount: 1 });
+    expect(spec('splash', 'beam')).toMatchObject({ kind: 'pulse', addedBeamDps: 3, addedBeamCount: 1 });
+    expect(spec('beam', 'beam')).toMatchObject({ kind: 'beam', beamDps: 6, addedBeamDps: 3, addedBeamCount: 1 });
+    expect(spec('bolt', 'beam', 'beam')).toMatchObject({ addedBeamDps: 6, addedBeamCount: 2 });
+    // Beam added never changes the attack's own damage or rate.
+    expect(spec('bolt', 'beam').damage).toBe(spec('bolt').damage);
+    expect(spec('bolt', 'beam').rate).toBe(spec('bolt').rate);
+  });
+
+  it('the card lines show the tier per second', () => {
+    expect(tierTowerLine(beam, 'common')).toBe('A continuous beam on the furthest enemy: 6 per second.');
+    expect(tierTowerLine(beam, 'rare')).toBe('A continuous beam on the furthest enemy: 8 per second.');
+    expect(tierTowerLine(beam, 'epic')).toBe('A continuous beam on the furthest enemy: 10 per second.');
+    expect(tierAddedLine(beam, 'common')).toBe('A second beam on the nearest enemy: 3 per second.');
+    expect(tierAddedLine(beam, 'rare')).toBe('A second beam on the nearest enemy: 4 per second.');
+    expect(tierAddedLine(beam, 'epic')).toBe('A second beam on the nearest enemy: 5 per second.');
+  });
+
+  it('the panel line names the beam and, with one added, the second beam', () => {
+    expect(describeSpec(spec('beam'))).toBe('A continuous beam on the furthest enemy: 6 per second.');
+    expect(describeSpec(spec('beam', 'beam'))).toBe('A continuous beam on the furthest enemy: 6 per second, and a second beam on the nearest enemy.');
+  });
+});
+
+describe('beam targeting', () => {
+  it('holds its target while it is alive and in range', () => {
+    const es = [e(1, 0, 5, 1), e(2, 0, 9, 2)];
+    expect(beamTarget(0, 0, 3, null, es)).toBe(1); // picks the furthest in range
+    expect(beamTarget(0, 0, 3, { index: 1, serial: 2 }, es)).toBe(1); // and holds it
+    expect(beamTarget(0, 0, 3, { index: 0, serial: 1 }, es)).toBe(0); // holds its target, even over a further enemy
+  });
+
+  it('snaps to the next-furthest the moment its target dies or leaves range', () => {
+    const es = [e(1, 0, 5, 1), e(2, 0, 9, 2)];
+    const held = { index: 1, serial: 2 };
+    es[1]!.active = false;
+    expect(beamTarget(0, 0, 3, held, es)).toBe(0);
+    es[1]!.active = true;
+    es[1]!.x = 4; // walks out of the beam's range
+    expect(beamTarget(0, 0, 3, held, es)).toBe(0);
+  });
+
+  it('treats a recycled slot as a new enemy (its serial changed)', () => {
+    const es = [e(1, 0, 5, 1), e(2, 0, 9, 2)];
+    es[1] = e(0.5, 0, 2, 3); // the slot is reused by a new, closer enemy
+    expect(beamTarget(0, 0, 3, { index: 1, serial: 2 }, es)).toBe(0); // the held one is gone: re-pick
+    expect(beamTarget(0, 0, 3, { index: 1, serial: 3 }, es)).toBe(1); // the new enemy is held
+  });
+
+  it('idles when nothing is in range', () => {
+    expect(beamTarget(0, 0, 3, null, [e(4, 0, 5, 1)])).toBe(-1);
+    expect(beamTarget(0, 0, 3, { index: 0, serial: 1 }, [e(4, 0, 5, 1)])).toBe(-1);
+  });
+
+  it('the second beam holds the in-range enemy nearest the anchor, skipping the anchor itself', () => {
+    const es = [e(2, 0, 9, 1), e(2.2, 0, 8, 2), e(1, 0, 5, 3)];
+    expect(secondBeamTarget(0, 0, 0, 3, es)).toBe(1); // nearest to the anchor (index 0)
+    expect(secondBeamTarget(0, 0, 0, 3, [e(2, 0, 9, 1)])).toBe(-1); // nothing else in range
+  });
+
+  it('the second beam idles while its anchor is absent', () => {
+    const es = [e(2, 0, 9, 1), e(2.2, 0, 8, 2)];
+    expect(secondBeamTarget(-1, 0, 0, 3, es)).toBe(-1);
+    es[0]!.active = false;
+    expect(secondBeamTarget(0, 0, 0, 3, es)).toBe(-1);
+  });
+});
+
+describe('the draft', () => {
+  it('Beam never opens a run (its line cannot hold wave 1), but rolls in the normal pool', () => {
+    expect(getAugment('beam').first.damage).toBe(0);
+    expect(getAugment('beam').opening).toBeUndefined();
+    expect(getAugment('beam').tier).toBeUndefined();
+    for (let seed = 1; seed <= 60; seed++)
+      expect(rollOffer(new Rng(seed), AUGMENTS, 3, 1, true).some((c) => c.id === 'beam')).toBe(false);
+    let rolled = 0;
+    for (let seed = 1; seed <= 300; seed++) for (const c of rollOffer(new Rng(seed), AUGMENTS, 3, 5)) if (c.id === 'beam') rolled += 1;
+    expect(rolled).toBeGreaterThan(0);
+  });
+});
