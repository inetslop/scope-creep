diff --git a/projects/chokepoint/game/src/core/beam.ts b/projects/chokepoint/game/src/core/beam.ts
new file mode 100644
index 0000000..d53b9c4
--- /dev/null
+++ b/projects/chokepoint/game/src/core/beam.ts
@@ -0,0 +1,60 @@
+import type { TargetCandidate } from './targeting';
+import { pickTarget } from './targeting';
+
+/** What a beam needs to know about an enemy (an Enemy satisfies this). */
+export interface BeamCandidate extends TargetCandidate {
+  /** Bumped on every spawn, so a recycled pool slot is a new enemy. */
+  serial: number;
+}
+
+/** The enemy a beam is holding: its pool index and the serial it had when the beam locked on. */
+export interface BeamHeld {
+  index: number;
+  serial: number;
+}
+
+/**
+ * Index of the enemy a beam at (x, y) with `range` (board units) should hold: the one it already
+ * holds, while that enemy is alive and still in range; otherwise the enemy furthest along in
+ * range (the same pick as a shot), or -1 when nothing is in range.
+ */
+export function beamTarget(x: number, y: number, range: number, held: BeamHeld | null, enemies: readonly BeamCandidate[]): number {
+  if (held) {
+    const e = enemies[held.index];
+    if (e && e.active && e.serial === held.serial) {
+      const dx = e.x - x;
+      const dy = e.y - y;
+      if (dx * dx + dy * dy <= range * range) return held.index;
+    }
+  }
+  return pickTarget(x, y, range, enemies);
+}
+
+/**
+ * Index of the enemy a second beam should hold: the in-range enemy nearest to the anchor enemy
+ * (the main target), skipping the anchor itself. -1 when the anchor is absent or nothing else is
+ * in range (the second beam then idles).
+ */
+export function secondBeamTarget(anchorIndex: number, x: number, y: number, range: number, enemies: readonly BeamCandidate[]): number {
+  const anchor = enemies[anchorIndex];
+  if (!anchor || !anchor.active) return -1;
+  let best = -1;
+  let bestD = Infinity;
+  const r2 = range * range;
+  for (let i = 0; i < enemies.length; i++) {
+    if (i === anchorIndex) continue;
+    const e = enemies[i]!;
+    if (!e.active) continue;
+    const dx = e.x - x;
+    const dy = e.y - y;
+    if (dx * dx + dy * dy > r2) continue;
+    const ddx = e.x - anchor.x;
+    const ddy = e.y - anchor.y;
+    const d = ddx * ddx + ddy * ddy;
+    if (d < bestD) {
+      best = i;
+      bestD = d;
+    }
+  }
+  return best;
+}
