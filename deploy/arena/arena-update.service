# Builds the newest Critter Clash from GitHub and switches to it when nobody is playing
# (/usr/local/sbin/arena-update, from deploy/arena/update.sh). Started by arena-update.timer.
[Unit]
Description=Critter Clash: build and deploy the newest game from GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/arena-update
TimeoutStartSec=30min
Nice=10
